        Y: 0.21978123486042023
        Z: 0.28802216053009033
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.4750002324581146
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 2.9118542671203613
    Saved: ~
